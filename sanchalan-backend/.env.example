# ─────────────────────────────────────────────────────────────────────────────
# SANCHALAN Backend — Environment Variables
# Copy this file to `.env` and edit as needed.
# All variables use the SANCHALAN_ prefix (set by pydantic-settings).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (local dev, no setup required, file lives alongside the app)
SANCHALAN_DATABASE_URL=sqlite:///./sanchalan.db

# Native PostgreSQL 16 (already running on this machine at port 5432):
# SANCHALAN_DATABASE_URL=postgresql://sanchalan:sanchalan@localhost:5432/sanchalan

# Docker PostgreSQL container (port 5433 — avoids clash with native Postgres):
# SANCHALAN_DATABASE_URL=postgresql://sanchalan:sanchalan@localhost:5433/sanchalan

# When running inside docker-compose (services talk over internal network, port 5432):
# SANCHALAN_DATABASE_URL=postgresql://sanchalan:sanchalan@postgres:5432/sanchalan

# ── Redis ─────────────────────────────────────────────────────────────────────
# Default: local Redis on the standard port
# The app works without Redis — if unreachable, caching/pub-sub is silently skipped.
SANCHALAN_REDIS_URL=redis://localhost:6379/0

# When running inside docker-compose:
# SANCHALAN_REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS in any non-local environment. Used to sign JWTs.
SANCHALAN_SECRET_KEY=change-me-in-.env

# JWT token lifetime (minutes). Default: 8 hours (480 min).
# SANCHALAN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# pydantic-settings parses JSON arrays from env vars, so use JSON syntax:
# SANCHALAN_CORS_ORIGINS='["http://localhost:5173","https://your-prod-domain.com"]'

# ── Simulation clock ──────────────────────────────────────────────────────────
# Hour offset from Monday 00:00 used as "now" by the dashboard sim.
# Default matches NOW_H in opsData.js (10.7 = Monday 10:42).
# SANCHALAN_NOW_H=10.7
